# TechSupport DM/greeting SEA pair (docs/TODO.md K3). This is the TechSupport *device* key, not a
# server secret: it lives here for dev convenience (`npm run dev:techsupport`,
# `npm run sign:techsupport-greeting`, `npm run sign:techsupport-identity`), never in the web
# bundle, and the relay only ever sees its public half (TECHSUPPORT_PUB in src/shared/techsupport.ts).
# Generate a new pair before any production deployment; never commit .env.local.
# Alternative: point `dev:techsupport` at a key file instead via TECHSUPPORT_KEY_FILE=path/to/key.json
# (see .gitignore's `secrets/` entry if you use that form).
TECHSUPPORT_SEA_PAIR_JSON='{"pub":"replace-with-sea-public-key","epub":"replace-with-sea-encryption-key","priv":"replace-with-private-key","epriv":"replace-with-encryption-private-key"}'
# Comma-separated browser origins accepted by the production API and WebSocket server.
# Defaults to iinpublic.com, www.iinpublic.com, and the initial Render hostname.
IINPUBLIC_ALLOWED_ORIGINS=

# Set only when an HTTPS-only hosting proxy (for example Render) terminates TLS.
# Without this flag, the Node server requires a local key and certificate.
IINPUBLIC_TLS_TERMINATED_BY_PROXY=

# Optional hosted release URLs. When unset, public/downloads/ is scanned instead.
IINPUBLIC_DOWNLOAD_MAC_URL=
IINPUBLIC_DOWNLOAD_WINDOWS_URL=
IINPUBLIC_DOWNLOAD_LINUX_URL=
IINPUBLIC_DOWNLOAD_ANDROID_URL=
IINPUBLIC_DOWNLOAD_IOS_URL=

# Optional base offset for every port used by `npm run test:all`. Set a different value in each
# concurrently active clone (for example 1000, 2000) to keep their Playwright port bands separate.
TEST_ALL_PORT_OFFSET="${TEST_ALL_PORT_OFFSET:-0}"
