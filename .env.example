# TechSupport key custody (docs/security/techsupport-key-custody-and-rotation.md). Production and
# operator machines should use an encrypted vault under the gitignored secrets/ directory. Keep
# its passphrase in a separate mode-600 file or inject it from a secret manager; never commit either.
# Generate: TECHSUPPORT_KEY_PASSPHRASE_FILE=... npm run techsupport:key -- generate --out secrets/techsupport-master.key.json
TECHSUPPORT_KEY_FILE=secrets/techsupport-master.key.json
TECHSUPPORT_KEY_PASSPHRASE_FILE=secrets/techsupport-master.passphrase
# TECHSUPPORT_KEY_PASSPHRASE=replace-with-secret-manager-injected-value
# Migration/dev compatibility only; do not deploy private key JSON in an environment variable:
# TECHSUPPORT_SEA_PAIR_JSON='{"pub":"...","epub":"...","priv":"...","epriv":"..."}'
# `npm run techsupport:agent` — minimal headless TechSupport operator process (scripts/techsupport-agent.js).
# Uses the TECHSUPPORT_KEY_FILE vault above. Point it at a real deployment with:
# TECHSUPPORT_APP_URL=https://your-deployed-host
# Optional poll interval override (ms, default 5000):
# TECHSUPPORT_AGENT_POLL_MS=5000
# Comma-separated browser origins accepted by the production API and WebSocket server.
# Defaults to iinpublic.com, www.iinpublic.com, and the initial Render hostname.
IINPUBLIC_ALLOWED_ORIGINS=

# Set only when an HTTPS-only hosting proxy (for example Render) terminates TLS.
# Without this flag, the Node server requires a local key and certificate.
IINPUBLIC_TLS_TERMINATED_BY_PROXY=

# Optional hosted release URLs. When unset, public/downloads/ is scanned instead.
IINPUBLIC_DOWNLOAD_MAC_URL=
IINPUBLIC_DOWNLOAD_WINDOWS_URL=
IINPUBLIC_DOWNLOAD_LINUX_URL=
IINPUBLIC_DOWNLOAD_ANDROID_URL=
IINPUBLIC_DOWNLOAD_IOS_URL=

# Optional OSM-compatible MapLibre style. Defaults to OpenFreeMap Liberty; point this at a
# self-hosted or contracted provider style when deployment requirements call for it.
IINPUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# TURN relay for WebRTC (docs/IinPublic_VPS_Installation_Guide.md's TURN section). Without these,
# the client falls back to STUN-only — pairs of devices whose NAT/router combination can't
# connect via host/STUN candidates alone simply fail to form a P2P session, with no fallback.
# TURN_SHARED_SECRET must match coturn's static-auth-secret on the TURN server exactly (same
# server as the relay works fine — that's what the install guide sets up). Never commit the real
# secret; generate one with `openssl rand -hex 32`.
TURN_SHARED_SECRET=
TURN_SERVER_HOST=
# Defaults to 3478 (coturn's standard TURN port) if unset.
TURN_SERVER_PORT=

# Optional base offset for every port used by `npm run test:all`. Set a different value in each
# concurrently active clone (for example 1000, 2000) to keep their Playwright port bands separate.
TEST_ALL_PORT_OFFSET="${TEST_ALL_PORT_OFFSET:-0}"
