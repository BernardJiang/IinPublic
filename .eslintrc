{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "jest": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "ignorePatterns": [
    "archive/",
    "coverage/",
    "dist/",
    "node_modules/",
    "playwright-report/",
    "test-results/"
  ],
  "globals": {
    "Audio": "readonly",
    "document": "readonly",
    "localStorage": "readonly",
    "navigator": "readonly",
    "window": "readonly"
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
