{
  "name": "iinpublic",
  "version": "1.0.0",
  "description": "IinPublic - Location-Based Chatbot Matching & Talk System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:stage-empty": "npm run dev:stage-zero",
    "dev:stage-zero": "node scripts/reset-dev-data.js && IINPUBLIC_STAGE_SEED=stage-zero DEV_GUN_FRESH=1 npm run dev",
    "dev:stage-user1": "IINPUBLIC_STAGE_SEED=user1 npm run dev",
    "dev:stage-user2-match": "IINPUBLIC_STAGE_SEED=user2-match npm run dev",
    "dev:stage-user3-network": "IINPUBLIC_STAGE_SEED=user3-network npm run dev",
    "dev:web": "webpack serve --mode development --config webpack.config.js",
    "dev:web:e2e": "DISABLE_HMR=true webpack serve --mode development --config webpack.config.js --no-watch",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:multi": "concurrently \"npm run dev\" \"node launch-browsers.js\"",
    "build": "npm run build:web && npm run build:server && npm run build:android",
    "build:web": "webpack --mode production --config webpack.config.js",
    "build:server": "tsc -p src/server/tsconfig.json",
    "build:android": "cd android && ./gradlew assembleDebug",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:type": "tsc --noEmit",
    "test:all": "npm run test:type && npm run test:coverage",
    "health": "npm run test:type && npm run lint && npm run test:unit && npm run test:integration && npm run build:web && npm run build:server",
    "test:unit+e2e": "npm run test:unit && npm run test:e2e",
    "test:e2e": "npm run build:server && DISABLE_HMR=true playwright test",
    "test:e2e:staged": "npm run build:server && E2E_STAGE_PIPELINE=1 PW_WORKERS=1 DISABLE_HMR=true playwright test",
    "test:e2e:talks-matching": "npm run build:server && DISABLE_HMR=true playwright test tests/e2e/talks-matching",
    "test:e2e:partial-auto": "npm run build:server && DISABLE_HMR=true playwright test tests/e2e/talks-matching/05-partial-auto-answers.spec.ts",
    "talk-test:survey-satisfaction": "tsx scripts/talk-tests/survey-customer-satisfaction.ts",
    "talk-test:survey-restaurants": "tsx scripts/talk-tests/survey-restaurants.ts",
    "talk-test:route-jobs": "tsx scripts/talk-tests/route-job-seeking.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "android:clean": "cd android && ./gradlew clean",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:install": "cd android && ./gradlew installDebug",
    "android:run": "npm run android:build && npm run android:install"
  },
  "keywords": [
    "chatbot",
    "location",
    "matching",
    "decentralized",
    "gun.js",
    "p2p"
  ],
  "author": "IinPublic Team",
  "license": "MIT",
  "dependencies": {
    "bad-words": "^3.0.4",
    "compromise": "^14.14.0",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "gun": "^0.2020.1241",
    "helmet": "^7.1.0",
    "node-geocoder": "^4.4.0",
    "rate-limiter-flexible": "^5.0.3",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@peculiar/webcrypto": "^1.5.0",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "babel-jest": "^30.2.0",
    "canvas": "^3.2.1",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "cytoscape": "^3.33.1",
    "cytoscape-dagre": "^2.5.0",
    "eslint": "^8.55.0",
    "express-http-proxy": "^2.1.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1",
    "react": "^19.2.4",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.4",
    "style-loader": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
