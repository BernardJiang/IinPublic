{
  "name": "iinpublic-desktop",
  "productName": "IinPublic",
  "version": "1.0.22",
  "description": "IinPublic desktop app — Electron shell hosting the embedded P2P node",
  "main": "main.js",
  "author": {
    "name": "IinPublic Team",
    "email": "hongyujiang@gmail.com"
  },
  "homepage": "https://github.com/BernardJiang/IinPublic",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:win:arm64": "electron-builder --win --arm64",
    "dist:win:all": "electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.iinpublic.desktop",
    "productName": "IinPublic",
    "files": [
      "main.js",
      "preload.js",
      "resources/**/*"
    ],
    "afterPack": "afterPack.js",
    "extraResources": [
      {
        "from": "../../dist/server",
        "to": "app/dist/server"
      },
      {
        "from": "../../dist/web",
        "to": "app/dist/web"
      },
      {
        "from": "../../public",
        "to": "app/public",
        "filter": [
          "**/*",
          "!downloads/**"
        ]
      },
      {
        "from": ".prod-deps-staging/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "resources/icon.icns"
    },
    "nsis": {
      "guid": "6f9f68bf-1077-5657-84fa-95bd35774b1a",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "uninstallDisplayName": "IinPublic",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BernardJiang",
        "repo": "IinPublic"
      }
    ]
  }
}
